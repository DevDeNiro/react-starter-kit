{
  "name": "react-starter-kit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:ci": "npm run typecheck && vite build && npm run test:run",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src .storybook --report-unused-disable-directives --fix",
    "lint:check": "eslint src .storybook --report-unused-disable-directives",
    "prepare": "husky",
    "pretty": "prettier . --write --ignore-unknown",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:coverage": "vitest --coverage",
    "deps:check": "ncu",
    "docker:build": "docker build -t react-starter-kit:latest .",
    "docker:tag": "docker tag react-starter-kit:latest localhost:5000/react-starter-kit:latest",
    "docker:import": "k3d image import react-starter-kit:latest -c dev-cluster",
    "docker:full": "npm run docker:build && npm run docker:import",
    "kube:deploy": "kubectl apply -f kube/",
    "kube:deploy-kustomize": "kubectl apply -k kube/",
    "kube:delete": "kubectl delete -f kube/",
    "kube:delete-kustomize": "kubectl delete -k kube/",
    "kube:restart": "kubectl rollout restart deployment/react-starter-kit -n ns-react-starter-kit",
    "kube:status": "kubectl get pods,svc,ingress -n ns-react-starter-kit",
    "kube:logs": "kubectl logs -f deployment/react-starter-kit -n ns-react-starter-kit",
    "kube:logs-previous": "kubectl logs --previous deployment/react-starter-kit -n ns-react-starter-kit",
    "kube:port-forward": "kubectl port-forward svc/react-starter-kit-service 8080:80 -n ns-react-starter-kit",
    "kube:scale-up": "kubectl scale deployment react-starter-kit --replicas=3 -n ns-react-starter-kit",
    "kube:scale-down": "kubectl scale deployment react-starter-kit --replicas=1 -n ns-react-starter-kit",
    "kube:describe": "kubectl describe deployment react-starter-kit -n ns-react-starter-kit",
    "kube:shell": "kubectl exec -it deployment/react-starter-kit -n ns-react-starter-kit -- /bin/sh",
    "hosts:add": "echo '127.0.0.1 react-starter-kit.local' | sudo tee -a /etc/hosts",
    "hosts:check": "grep 'react-starter-kit.local' /etc/hosts || echo 'Not found in hosts file'",
    "deploy:full": "npm run docker:full && npm run kube:deploy && npm run hosts:add",
    "deploy:update": "npm run docker:full && npm run kube:restart",
    "deploy:clean": "npm run kube:delete"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "oidc-client-ts": "^3.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-intl": "^7.1.11",
    "react-oidc-context": "^3.3.0",
    "@reduxjs/toolkit": "^2.8.2",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.0",
    "styled-components": "^6.1.18",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.6",
    "@eslint/js": "^9.27.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/react": "^16.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "3.1.4",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^0.12.0",
    "globals": "^16.2.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "msw": "^2.8.4",
    "npm-check-updates": "23.1.0",
    "prettier": "^3.5.3",
    "storybook": "^8.6.14",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "8.0.16",
    "vitest": "5.0.0-rc.2"
  }
}

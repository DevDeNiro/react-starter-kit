# Environnement
NODE_ENV=development
VITE_NODE_ENV=development

# Serveur de développement
VITE_HOST=localhost
VITE_PORT=4200
VITE_OPEN_BROWSER=true
VITE_OPEN_URL=http://localhost:4200

# HTTPS (optionnel)
VITE_USE_HTTPS=false
VITE_SSL_KEY_PATH=./certs/localhost-key.pem
VITE_SSL_CERT_PATH=./certs/localhost.pem

# API
VITE_API_URL=http://localhost:3000

# OIDC Configuration
VITE_OIDC_AUTHORITY=https://localhost:5001/iamconfiguration
VITE_OIDC_CLIENT_ID=react
VITE_OIDC_REDIRECT_URI=http://localhost:4200/authentication/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4200/
VITE_OIDC_SILENT_REDIRECT_URI=http://localhost:4200/authentication/silent_callback